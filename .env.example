# Copy this file to .env and fill in real values for prod mode.
APOLLO_LLM_API_KEY=your_api_key_here
APOLLO_LLM_MODEL=gpt-4o-mini
APOLLO_LLM_BASE_URL=https://api.openai.com/v1

# bge downloads/loads the sentence-transformers model; hash is for smoke tests.
APOLLO_EMBEDDING=bge

# openai uses the compatible chat completions API; dry-run is local deterministic arbitration.
APOLLO_LLM_MODE=openai
